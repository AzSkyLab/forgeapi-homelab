# Optional. Copy to .env (gitignored). Nothing here is required to start.
# FORGEAPI_DATA_DIR=.local/data

# Identity Terraform runs as (ARM_* is derived from these). Server-side only.
# FORGEAPI_AZURE_TENANT_ID=
# FORGEAPI_AZURE_SUBSCRIPTION_ID=
# FORGEAPI_AZURE_CLIENT_ID=
# Local development only: PKCS#12 bundle for the dedicated app registration. Unset when hosted.
# FORGEAPI_AZURE_CLIENT_CERTIFICATE_PATH=.local/executor/client.pfx

# Hosted on Azure (Container Apps): managed identity instead of the certificate, for Terraform
# and for Table Storage. See docs/hosting-plan.md.
# FORGEAPI_AZURE_USE_MANAGED_IDENTITY=true

# Deployment records. Default sqlite (local file). table = Azure Table Storage, Entra auth.
# FORGEAPI_DB_BACKEND=table
# FORGEAPI_TABLE_STORAGE_ACCOUNT=
# FORGEAPI_TABLE_NAME=deployments

# Remote Terraform state (azurerm backend): one blob per deployment, Entra auth, no keys.
# FORGEAPI_STATE_RESOURCE_GROUP=
# FORGEAPI_STATE_STORAGE_ACCOUNT=
# FORGEAPI_STATE_CONTAINER=tfstate

# Private pattern repos. Natively, leave unset: git uses your own credential helper (gh).
# For Docker pass it at run time instead of storing it here:
#   FORGEAPI_GITHUB_TOKEN=$(gh auth token) docker compose up --build -d

# Entra auth (M5). Default is AUTH_MODE=none for loopback development.
# FORGEAPI_AUTH_MODE=entra
# FORGEAPI_ENTRA_TENANT_ID=
# FORGEAPI_ENTRA_AUDIENCE=
