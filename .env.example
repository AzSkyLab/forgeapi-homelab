# Optional. Copy to .env (gitignored). Nothing here is required to start.
# FORGEAPI_DATA_DIR=.local/data

# Identity Terraform runs as (ARM_* is derived from these). Server-side only.
# FORGEAPI_AZURE_TENANT_ID=
# FORGEAPI_AZURE_SUBSCRIPTION_ID=
# FORGEAPI_AZURE_CLIENT_ID=
# Local development only: PKCS#12 bundle for the dedicated app registration. Unset when hosted.
# FORGEAPI_AZURE_CLIENT_CERTIFICATE_PATH=.local/executor/client.pfx

# Future supported Azure hosting (not the old separate Container Apps layout): managed identity instead of the certificate, for Terraform
# See docs/work-deployment.md for the current local-disk requirement.
# FORGEAPI_AZURE_USE_MANAGED_IDENTITY=true

# Agent operation ledger requires sqlite. The following Table settings are LEGACY ONLY.
# FORGEAPI_DB_BACKEND=table
# FORGEAPI_TABLE_STORAGE_ACCOUNT=
# FORGEAPI_TABLE_NAME=deployments

# Remote Terraform state (azurerm backend): one blob per deployment, Entra auth, no keys.
# FORGEAPI_STATE_RESOURCE_GROUP=
# FORGEAPI_STATE_STORAGE_ACCOUNT=
# FORGEAPI_STATE_CONTAINER=tfstate

# Private pattern repos. Natively, leave unset: git uses your own credential helper (gh).
# For Docker pass it at run time instead of storing it here:
#   FORGEAPI_GITHUB_TOKEN=$(gh auth token) docker compose up --build -d

# Business units: placement, injected inputs, ownership (docs/tenancy.md). Unset = single-tenant.
# FORGEAPI_TENANTS_PATH=tenants.yaml
# FORGEAPI_TENANTS_YAML=<the mapping as text; for hosted apps, e.g. from a Key Vault reference>
# FORGEAPI_DEV_GROUPS=<group-id>,<group-id>   # your groups when AUTH_MODE=none

# Entra auth (M5). Default is AUTH_MODE=none for loopback development.
# FORGEAPI_AUTH_MODE=entra        # or `easyauth` behind Container Apps Easy Auth
# FORGEAPI_ENTRA_TENANT_ID=
# FORGEAPI_ENTRA_AUDIENCE=
# AUTH_MODE=none normally refuses a non-loopback caller. Lab-only: set true to let one in
# anyway (e.g. compose, where the API is reached over the docker bridge, not loopback).
# FORGEAPI_ALLOW_UNAUTHENTICATED_REMOTE=true

# Temporal dispatch (API and worker must agree on namespace and queue).
# Default local server: uv run python -m app.devserver
# FORGEAPI_TEMPORAL_ADDRESS=localhost:7233
# FORGEAPI_TEMPORAL_NAMESPACE=default
# FORGEAPI_TASK_QUEUE=forgeapi

# Opt-in: expire a planned operation not executed within this many hours (unset: never).
# FORGEAPI_PLAN_MAX_AGE_HOURS=
